---
/**
 * Phase-1 placeholder for the apartment gallery: proves the units data, i18n and the
 * AVIF/WebP plan pipeline. Replaced by the filterable gallery + viewer in phase 2.
 */
import { Picture } from 'astro:assets';
import { formatArea, units } from '../data/units';
import { fmt, getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section id="apartments" class="section units" aria-labelledby="units-title">
  <div class="container container--wide">
    <p class="eyebrow">{t.units.eyebrow}</p>
    <h2 id="units-title" class="units__title">{t.units.title}</h2>
    <ul role="list" class="units__grid" data-reveal="stagger">
      {
        units.map((u) => (
          <li class="units__card" id={u.id}>
            <Picture
              src={u.plan}
              formats={['avif', 'webp']}
              widths={[360, 560, 800]}
              sizes="(min-width: 75rem) 30vw, (min-width: 45rem) 45vw, 92vw"
              alt={fmt(t.units.planAlt, { code: u.code })}
              loading="lazy"
              decoding="async"
            />
            <h3 class="units__code">{u.code}</h3>
            <p>{fmt(t.units.bedroomsN, { n: u.bedrooms })}</p>
            <dl class="units__specs">
              <div>
                <dt>{t.units.gross}</dt>
                <dd>{formatArea(u.gross, lang)}</dd>
              </div>
              <div>
                <dt>{t.units.net}</dt>
                <dd>{formatArea(u.net, lang)}</dd>
              </div>
            </dl>
            <p class="units__rooms">{u.rooms.map((r) => t.rooms[r]).join(' · ')}</p>
            <p class="units__price">{t.units.price}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .units__title {
    font-size: var(--step-4);
    margin-block: var(--space-2xs) var(--space-xl);
  }

  .units__grid {
    display: grid;
    gap: var(--space-l);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
  }

  .units__card {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-s);
    background: var(--color-surface);
    border-radius: var(--radius-m);
    box-shadow: var(--shadow-soft);
  }

  .units__card :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 8 / 7;
    object-fit: contain;
  }

  .units__code {
    font-size: var(--step-2);
  }

  .units__specs {
    display: flex;
    gap: var(--space-m);
    font-size: var(--step--1);
  }

  .units__specs dt {
    color: var(--color-text-muted);
  }

  .units__rooms,
  .units__price {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .units__price {
    color: var(--color-accent-text);
    font-weight: 600;
  }
</style>
