---
/**
 * The whole landing page, shared by every language route (src/pages/index.astro, src/pages/am/index.astro).
 * Section order and themes: DESIGN §4.
 */
import Base from '../layouts/Base.astro';
import Intro from './Intro.astro';
import Header from './Header.astro';
import Hero from './sections/Hero.astro';
import Facts from './sections/Facts.astro';
import Story from './sections/Story.astro';
import Explore from './sections/Explore.astro';
import Homes from './sections/Homes.astro';
import Location from './sections/Location.astro';
import Payment from './sections/Payment.astro';
import Enquire from './sections/Enquire.astro';
import Footer from './Footer.astro';
import MobileCta from './MobileCta.astro';
import FilmDialog from './film/FilmDialog.astro';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

---

<!-- DESIGN §5.1 rev 6: the LCP is the hero film's poster (17 KB WebP), preloaded with high priority -->
<Base lang={lang} preloadImage={{ href: '/video/hero-bg-poster.webp', type: 'image/webp' }}>
  <Intro />
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} />
    <Facts lang={lang} />
    <Story lang={lang} />
    <Explore lang={lang} />
    <Homes lang={lang} />
    <Location lang={lang} />
    <Payment lang={lang} />
    <Enquire lang={lang} />
  </main>
  <Footer lang={lang} />
  <MobileCta lang={lang} />
  <FilmDialog lang={lang} />
</Base>

<style>
  main:focus {
    outline: none;
  }

</style>
