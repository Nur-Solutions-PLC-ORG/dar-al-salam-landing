---
/**
 * The whole landing page, shared by every language route (src/pages/index.astro, src/pages/am/index.astro).
 * Section order and themes: DESIGN §4.
 */
import Base from '../layouts/Base.astro';
import Intro from './Intro.astro';
import Header from './Header.astro';
import Hero from './sections/Hero.astro';
import Facts from './sections/Facts.astro';
import Story from './sections/Story.astro';
import Explore from './sections/Explore.astro';
import Homes from './sections/Homes.astro';
import Location from './sections/Location.astro';
import Payment from './sections/Payment.astro';
import Enquire from './sections/Enquire.astro';
import Footer from './Footer.astro';
import MobileCta from './MobileCta.astro';
import heroTower from '../assets/generated/hero-tower.jpg';
import { responsiveSet } from '../lib/images';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// DESIGN §5.1: widths 360…1560. Mobile arch = min(content width, 58svh × 0.8); desktop = cols 7–12.
const heroImage = await responsiveSet(
  heroTower,
  [360, 540, 720, 960, 1280, 1560],
  '(min-width: 1024px) min(46vw, 640px), min(calc(100vw - 2rem), 47svh)',
);
---

<Base lang={lang} preloadImage={{ srcset: heroImage.avif, sizes: heroImage.sizes, type: 'image/avif' }}>
  <Intro />
  <Header lang={lang} />
  <main id="main" tabindex="-1">
    <Hero lang={lang} image={heroImage} />
    <Facts lang={lang} />
    <Story lang={lang} />
    <div class="dusk-veil" aria-hidden="true" data-dusk-veil></div>
    <Explore lang={lang} />
    <Homes lang={lang} />
    <Location lang={lang} />
    <Payment lang={lang} />
    <Enquire lang={lang} />
  </main>
  <Footer lang={lang} />
  <MobileCta lang={lang} />
</Base>

<style>
  main:focus {
    outline: none;
  }

  /* S9: fixed navy veil scrubbed in before the explorer (opacity only; inert without JS) */
  .dusk-veil {
    position: fixed;
    inset: 0;
    background: var(--navy-900);
    opacity: 0;
    pointer-events: none;
    z-index: 1;
    visibility: hidden;
  }
</style>
