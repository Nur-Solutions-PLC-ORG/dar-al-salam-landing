---
/** Provisional hero (phase 1). The LCP image is preloaded by Base via the same srcset. */
import type { ResponsiveSet } from '../lib/images';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  image: ResponsiveSet;
}

const { lang, image } = Astro.props;
const t = getDict(lang);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container container--wide hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">{t.hero.title}</h1>
      <p class="hero__lead">{t.hero.lead}</p>
      <div class="hero__ctas">
        <a class="btn btn--primary" href="#enquire">{t.cta.bookVisit}</a>
        <a class="btn btn--ghost" href="#apartments">{t.cta.explore}</a>
      </div>
    </div>
    <div class="hero__media">
      <picture>
        <source type="image/avif" srcset={image.avif} sizes={image.sizes} />
        <source type="image/webp" srcset={image.webp} sizes={image.sizes} />
        <img
          src={image.src}
          width={image.width}
          height={image.height}
          alt={t.hero.imageAlt}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-xl) var(--space-2xl);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }

  .hero__copy {
    display: grid;
    gap: var(--space-m);
    justify-items: start;
  }

  .hero__title {
    font-size: var(--step-5);
  }

  .hero__lead {
    max-width: 36ch;
    font-size: var(--step-1);
    color: var(--color-text-muted);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
  }

  .hero__media img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-l);
    aspect-ratio: 2251 / 2163;
    object-fit: cover;
  }
</style>
