---
/**
 * Tower explorer (DESIGN §5.4, §9). Navy section with an ivory "paper" panel (.theme-paper).
 * All three panel views are server-rendered; src/scripts/explorer/* is a state machine that toggles them
 * and syncs #explore / #explore/f7 / #explore/f7/bl05 (replaceState).
 * No JS: the floor list and the key plan (hotspots link to the home cards) are shown; the unit view is hidden.
 * Model tiers: 0 = this SVG (always), 1 = SVG + JS interactions, 2 = lazy Three.js canvas over it.
 */
import { Picture } from 'astro:assets';
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Maquette from '../explorer/Maquette.astro';
import KeyPlan from '../explorer/KeyPlan.astro';
import { sections } from '../../data/sections';
import { site } from '../../data/site';
import { units, planFloors, floorComposition, floorSlots, twoBedFloors, formatArea, unitByCode } from '../../data/units';
import { emph, floorList, floorMix, fmt, getDict, plain, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
const floorsDesc = [...planFloors].reverse();
const twoBedFloorsText = floorList(twoBedFloors, lang);
/** Row mix split so the "1 to be confirmed" part can be muted (DESIGN §9.2 rev 5); text = floorMix(). */
const mixParts = (n: number) => {
  const c = floorComposition(n);
  return { main: floorMix({ ...c, tbc: 0 }, t), tbc: c.tbc ? floorMix({ twoBed: 0, threeBed: 0, tbc: c.tbc }, t) : '' };
};
/** Homes with a to-be-confirmed position on some floors (BL01): they get a TBC chip variant. */
const tbcCodes = new Set(planFloors.flatMap((n) => floorSlots(n).filter((s) => s.status === 'tbc').map((s) => s.code)));
const tbcUnit = unitByCode('BL01')!;
/** Positions still to be confirmed on a floor (row data-tbc; the controller reads it with the row's mix text). */
const tbcOf = (n: number) => floorSlots(n).filter((s) => s.status === 'tbc').map((s) => s.code).join(' ') || undefined;

/** Strings the client formats at runtime. */
const i18n = {
  floorN: t.explore.floorN,
  viewFloor: t.explore.viewFloor,
  keyplanLabel: t.explore.keyplanLabel,
  requestFor: t.explore.requestFor,
  unitOnFloor: t.explore.unitOnFloor,
  backToFloor: t.explore.backToFloor,
  floorTooltip: t.explore.floorTooltip,
  bedShort: t.explore.bedShort,
  hintTouch: t.explore.hintTouch,
  hintPointer: t.explore.hintPointer,
  hintHover: t.explore.hintHover,
  tbc: t.explore.tbc,
  tbcAria: t.explore.tbcAria,
  tbcBody: fmt(t.explore.tbcBody, { floors: twoBedFloorsText }),
  seeOn: t.explore.seeOn,
};
const roomList = (u: (typeof units)[number]) => u.rooms.map((r) => t.rooms[r]).join(', ');
---

<section
  id="explore"
  class="section theme-dusk explore"
  aria-labelledby="explore-title"
  data-header-theme="dark"
  data-explore
  data-state="idle"
  data-i18n={JSON.stringify(i18n)}
  data-lang={lang}
>
  <div class="container">
    <div class="explore__head">
      <div>
        <Eyebrow n={sections.explore.n} label={t.explore.eyebrow} />
        <h2 id="explore-title" class="h2 explore__title" data-split set:html={emph(t.explore.title)} />
      </div>
      <nav class="crumbs" aria-label={t.explore.breadcrumb} data-crumbs hidden>
        <ol role="list">
          <li><button type="button" class="crumbs__btn" data-crumb="idle">{t.explore.tower}</button></li>
          <li data-crumb-floor-li hidden>
            <span aria-hidden="true" class="crumbs__sep">›</span>
            <button type="button" class="crumbs__btn" data-crumb="floor"></button>
          </li>
          <li data-crumb-unit-li hidden>
            <span aria-hidden="true" class="crumbs__sep">›</span>
            <span class="crumbs__current" aria-current="location" data-crumb-unit></span>
          </li>
        </ol>
      </nav>
    </div>

    <div class="explore__grid" data-explore-grid>
      <div class="explore__model" data-model-col>
        <div class="explore__stage" data-stage>
          <Maquette />
          <div class="explore__canvas" data-canvas aria-hidden="true"></div>
          <div class="explore__tooltip" data-tooltip aria-hidden="true" hidden></div>
          <p class="explore__hint" data-hint aria-hidden="true" hidden></p>
          <button type="button" class="explore__load3d" data-load-3d hidden>{t.explore.load3d}</button>
        </div>

        <div class="explore__stepper" data-model-stepper>
          <div class="stepper">
            <button type="button" class="stepper__btn" data-step="-1" aria-label={t.explore.prevFloor}>−</button>
            <span class="stepper__label tabular" data-stepper-label aria-live="polite">{fmt(t.explore.floorN, { n: 1 })}</span>
            <button type="button" class="stepper__btn" data-step="1" aria-label={t.explore.nextFloor}>+</button>
          </div>
          <Button class="explore__view" data-view-floor>{fmt(t.explore.viewFloor, { n: 1 })}</Button>
        </div>

        <p class="explore__strip small">{t.explore.strip}</p>
      </div>

      <div class="explore__panel theme-paper" data-panel data-lenis-prevent>
        <!-- IDLE: floor list (primary accessible control) -->
        <div class="view view--idle" data-view="idle">
          <h3 class="view__title h3">{t.explore.floorList}</h3>
          {
            site.project.topFloorPlanned && (
              <p class="small floors__planned">
                <span class="floors__planned-glyph" aria-hidden="true" />
                {t.explore.topFloorPlanned}
              </p>
            )
          }
          <ol role="list" class="floors">
            {
              floorsDesc.map((n) => (
                <li>
                  <button type="button" class="floors__row" data-floor={n} data-tbc={tbcOf(n)}>
                    <span class="floors__n">{fmt(t.explore.floorN, { n })}</span>
                    <span class="floors__mix small">
                      {mixParts(n).main}
                      {mixParts(n).tbc && <span class="floors__tbc">{` · ${mixParts(n).tbc}`}</span>}
                    </span>
                    <svg class="floors__chev" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                      <path d="M6 3l5 5-5 5" />
                    </svg>
                  </button>
                </li>
              ))
            }
          </ol>
          <p class="small muted floors__twobed">{fmt(t.explore.twoBedOn, { floors: twoBedFloorsText })}</p>
          <p class="small muted floors__legend">{t.explore.legend}</p>
        </div>

        <!-- FLOOR(n): key plan + unit chips -->
        <div class="view view--floor" data-view="floor">
          <div class="view__bar">
            <h3 class="view__title h3" tabindex="-1" data-floor-title>{t.explore.typicalFloor}</h3>
            <div class="stepper stepper--panel" data-panel-stepper>
              <button type="button" class="stepper__btn" data-step="-1" aria-label={t.explore.prevFloor} data-magnetic>−</button>
              <button type="button" class="stepper__btn" data-step="1" aria-label={t.explore.nextFloor} data-magnetic>+</button>
            </div>
          </div>
          <KeyPlan lang={lang} />
          <ul role="list" class="chips" aria-label={t.explore.unitList}>
            {
              units.map((u) => (
                <li>
                  <button
                    type="button"
                    class="chip"
                    data-unit={u.code}
                    data-pill={`${fmt(t.explore.bedShort, { n: u.bedrooms })} · ${formatArea(u.gross, lang)}`}
                    aria-pressed="false"
                  >
                    <span class="chip__code">
                      {u.code}
                      {u.bedrooms === 2 ? (
                        <span class="chip__tag">{fmt(t.explore.bedShort, { n: u.bedrooms })}</span>
                      ) : (
                        <span class="visually-hidden">{fmt(t.explore.bedShort, { n: u.bedrooms })}</span>
                      )}
                    </span>
                    <span class="chip__meta tabular">{formatArea(u.gross, lang)}</span>
                    {tbcCodes.has(u.code) && (
                      <>
                        <span class="chip__code chip__tbc-code">{u.code}</span>
                        <span class="chip__meta chip__tbc-meta">{t.explore.tbc}</span>
                      </>
                    )}
                  </button>
                </li>
              ))
            }
          </ul>
          <button type="button" class="link view__back" data-back="idle">
            <span aria-hidden="true">‹</span> {t.explore.backToTower}
          </button>
        </div>

        <!-- UNIT(n, code): plan + specs + CTAs -->
        <div class="view view--unit" data-view="unit">
          {
            units.map((u) => (
              <article class="unit" data-unit-card={u.code} aria-labelledby={`explore-unit-${u.id}`} hidden>
                <button type="button" class="unit__plan" data-open-plan={u.code} aria-label={fmt(t.explore.openPlan, { code: u.code })}>
                  <Picture
                    src={u.plan}
                    formats={['avif', 'webp']}
                    widths={[400, 600, 800]}
                    width={600}
                    fallbackFormat="jpg"
                    sizes="(min-width: 1024px) 36vw, 90vw"
                    alt={fmt(t.homes.planAlt, { code: u.code, n: u.bedrooms, rooms: roomList(u) })}
                    loading="lazy"
                    decoding="async"
                  />
                </button>
                <div class="unit__body">
                  <p class="eyebrow" data-unit-where>{u.code}</p>
                  <h3 class="h3" id={`explore-unit-${u.id}`} tabindex="-1" data-unit-title>
                    {fmt(t.homes.bedroomsN, { n: u.bedrooms })}
                  </h3>
                  <dl class="unit__specs tabular">
                    <div>
                      <dt>{t.homes.grossArea}</dt>
                      <dd>{formatArea(u.gross, lang)}</dd>
                    </div>
                    <div>
                      <dt>{t.homes.netArea}</dt>
                      <dd>{formatArea(u.net, lang)}</dd>
                    </div>
                  </dl>
                  <p class="small muted unit__rooms">
                    <span class="visually-hidden">{t.homes.rooms}: </span>
                    {u.rooms.map((r) => t.rooms[r]).join(' · ')}
                  </p>
                  <div class="unit__actions">
                    <Button href="#enquire" data-request={u.code} aria-label={plain(fmt(t.homes.viewer.requestFor, { code: u.code }))}>
                      {t.cta.requestPricing}
                    </Button>
                    <Button href="#enquire" variant="secondary">
                      {t.cta.bookVisit}
                    </Button>
                  </div>
                </div>
              </article>
            ))
          }
          <!-- rev 5: BL01 on a floor where it is not confirmed (DESIGN §9.2): no plan, no type, no m² -->
          <article class="unit unit--tbc" data-unit-tbc aria-labelledby="explore-unit-tbc" hidden>
            <div class="unit__tbc-plan" style={`aspect-ratio: ${tbcUnit.plan.width} / ${tbcUnit.plan.height}`} aria-hidden="true">
              <span class="tbc-chip">{t.explore.tbc}</span>
            </div>
            <div class="unit__body">
              <h3 class="eyebrow unit__tbc-title" id="explore-unit-tbc" tabindex="-1" data-unit-title data-unit-where>{tbcUnit.code}</h3>
              <p class="muted" data-tbc-body>{fmt(t.explore.tbcBody, { n: 1, floors: twoBedFloorsText })}</p>
              <div class="unit__actions">
                <Button href="#enquire" data-request={tbcUnit.code}>{t.explore.askAbout}</Button>
                <Button variant="secondary" data-see-confirmed={tbcUnit.code}>{fmt(t.explore.seeOn, { code: tbcUnit.code, n: twoBedFloors[0]! })}</Button>
              </div>
            </div>
          </article>
          <div class="unit__nav">
            <button type="button" class="link view__back" data-back="floor" data-back-floor-label>
              <span aria-hidden="true">‹</span> <span data-back-floor-text>{t.explore.backToTower}</span>
            </button>
            <div class="stepper">
              <button type="button" class="stepper__btn" data-unit-step="-1" aria-label={t.explore.prevUnit}>‹</button>
              <button type="button" class="stepper__btn" data-unit-step="1" aria-label={t.explore.nextUnit}>›</button>
            </div>
          </div>
          <p class="small muted">{t.homes.disclaimer}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .explore {
    position: relative;
  }

  /* S9 (DESIGN rev 3): a static ivory → navy dusk gradient above the explorer, no JS */
  .explore::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 100%;
    height: 32svh;
    background: linear-gradient(to bottom, rgb(15 24 40 / 0), var(--navy-900));
    pointer-events: none;
  }

  .explore__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5);
    margin-bottom: var(--space-7);
  }

  .explore__title {
    margin-top: var(--space-5);
    max-width: 16ch;
  }

  .crumbs ol {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--fs-small);
  }

  .crumbs li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .crumbs__btn {
    min-height: var(--tap-min);
    padding-inline: var(--space-2);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
  }

  .crumbs__current {
    font-weight: 600;
    color: var(--accent-text);
  }

  .crumbs__sep {
    color: var(--text-muted);
  }

  .explore__grid {
    display: grid;
    gap: var(--space-6);
  }

  .explore__model {
    display: grid;
    gap: var(--space-4);
    align-content: start;
  }

  .explore__stage {
    position: relative;
    height: 52svh;
    min-height: 320px;
    touch-action: pan-y;
  }

  .explore__stage :global(.maquette) {
    transition: opacity 0.6s var(--ease-out);
  }

  .explore__stage[data-tier='3d'] :global(.maquette) {
    opacity: 0;
  }

  .explore__canvas {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none; /* never block the SVG tier underneath */
    transition: opacity 0.6s var(--ease-out);
  }

  .explore__stage[data-tier='3d'] .explore__canvas {
    opacity: 1;
    pointer-events: auto;
  }

  .explore__stage[data-tier='3d'] :global(.maquette) {
    pointer-events: none;
  }

  .explore__canvas :global(canvas) {
    display: block;
    width: 100% !important;
    height: 100% !important;
    touch-action: pan-y;
  }

  .explore__tooltip {
    position: absolute;
    left: 0;
    top: 0;
    transform: translate(var(--tx, 0), var(--ty, 0)) translateY(-50%);
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--ivory-50);
    color: var(--navy-800);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    pointer-events: none;
    box-shadow: var(--shadow-2);
    z-index: 2;
  }

  /* top-left: the top of the frame is empty now that the tower fills it (design QA follow-up) */
  .explore__hint {
    position: absolute;
    left: 0;
    top: 12px;
    padding: 0.35rem 0.9rem;
    border-radius: var(--radius-pill);
    background: rgb(15 24 40 / 0.72);
    border: 1px solid var(--line);
    font-size: 0.8125rem;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.4s var(--ease-out);
  }

  .explore__hint[data-done] {
    opacity: 0;
  }

  .explore__load3d {
    position: absolute;
    top: var(--space-2);
    right: 0;
    min-height: var(--tap-min);
    padding-inline: var(--space-4);
    border-radius: var(--radius-pill);
    border: 1px solid var(--btn2-border);
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .explore__stepper {
    display: none;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  :global(html.js) .explore__stepper {
    display: flex;
  }

  .explore__strip {
    color: var(--text-muted);
  }

  /* stepper */
  .stepper {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
  }

  .stepper__btn {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--input-border);
    font-size: 1.25rem;
    line-height: 1;
  }

  .stepper__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .stepper__label {
    min-width: 7.5em;
    text-align: center;
    font-weight: 600;
  }

  /* panel */
  .explore__panel {
    border-radius: var(--radius-s);
    box-shadow: var(--shadow-2);
    padding: var(--space-5) var(--space-4);
    min-width: 0;
  }

  .view {
    display: grid;
    gap: var(--space-5);
  }

  /* with JS only the active view shows; without JS idle + floor show, unit stays hidden */
  :global(html.js) .explore[data-ready] .view:not(.is-active) {
    display: none;
  }

  .view--unit {
    display: none;
  }

  :global(html.js) .explore[data-ready] .view--unit.is-active {
    display: grid;
  }

  :global(html:not(.js)) .view--floor,
  .explore:not([data-ready]) .view--floor {
    margin-top: var(--space-7);
  }

  .view__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .view__title {
    outline-offset: 4px;
  }

  .stepper--panel {
    display: none;
  }

  :global(html.js) .explore[data-ready] .stepper--panel {
    display: inline-flex;
  }

  .view__back {
    justify-self: start;
  }

  /* floor list */
  .floors {
    border-top: 1px solid var(--line);
  }

  .floors__row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 48px;
    padding: var(--space-2) var(--space-2);
    border-bottom: 1px solid var(--line);
    text-align: start;
    position: relative;
    isolation: isolate;
  }

  .floors__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold-500);
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }

  .floors__row:is(:hover, :focus-visible, .is-preview)::before {
    opacity: 0.16;
  }

  .floors__n {
    font-weight: 600;
    min-width: 6.5em;
  }

  .floors__mix {
    color: var(--text-muted);
  }

  .floors__chev {
    width: 16px;
    height: 16px;
    color: var(--accent-text);
  }

  /* "1 to be confirmed" is muted; the confirmed part keeps the normal text colour (rev 5) */
  .floors__mix {
    color: var(--text);
  }

  .floors__tbc {
    color: var(--text-muted);
  }

  .floors__twobed,
  .floors__legend {
    margin-top: calc(-1 * var(--space-2));
  }

  .floors__twobed + .floors__legend {
    margin-top: calc(-1 * var(--space-4));
  }

  /* "16th floor planned": a note, not a row (rev 5); dashed = "not drawn yet", like the TBC hatch */
  .floors__planned {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 40px;
    margin-bottom: calc(-1 * var(--space-3));
    padding-inline: var(--space-2);
    border-bottom: 1px dashed var(--line);
    color: var(--text-muted);
  }

  .floors__planned-glyph {
    width: 10px;
    height: 10px;
    flex: none;
    border: 1px dashed currentColor;
  }

  /* < 480 px the mix moves under the floor number, so every floor keeps its own composition */
  @media (max-width: 479.98px) {
    .floors__row {
      grid-template-columns: 1fr auto;
      row-gap: 0;
    }

    .floors__mix {
      grid-column: 1;
      grid-row: 2;
    }

    .floors__chev {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  /* unit chips */
  .chips {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-2);
    overscroll-behavior-x: contain;
  }

  .chip {
    scroll-snap-align: start;
    overflow: hidden;
    display: grid;
    min-width: 8.5rem;
    min-height: var(--tap-min);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-xs);
    box-shadow: inset 0 0 0 1px var(--input-border);
    text-align: start;
    position: relative;
    isolation: isolate;
  }

  .chip::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--gold-500);
    opacity: 0;
    transition: opacity 0.25s var(--ease-out);
  }

  .chip:is(:hover, .is-preview)::before {
    opacity: 0.18;
  }

  .chip[aria-pressed='true']::before {
    opacity: 0.45;
  }

  /* two even lines: code (+ a "2 bed" tag on the one 2-bed type) / gross area (design QA follow-up) */
  .chip__code {
    display: flex;
    align-items: center;
    gap: 0.3em;
    font-weight: 700;
    font-size: var(--fs-small);
    white-space: nowrap;
  }

  .chip__tag {
    padding: 0 0.3em;
    border-radius: var(--radius-xs);
    background: var(--sand-200);
    font-size: 0.625rem;
    font-weight: 600;
  }

  .chip__meta {
    white-space: nowrap;
  }

  .chip__meta {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* rev 5: a to-be-confirmed position (BL01 off floors 4, 6, 8, 10, 11): dashed, muted, no type, no m² */
  .chip__tbc-code,
  .chip__tbc-meta,
  .chip[data-tbc] > :not(.chip__tbc-code, .chip__tbc-meta) {
    display: none;
  }

  .chip[data-tbc] > :is(.chip__tbc-code, .chip__tbc-meta) {
    display: flex;
  }

  /* "To be confirmed" wraps inside the narrow 3×3 chip instead of spilling into the next one */
  .chip[data-tbc] > .chip__tbc-meta {
    display: block;
    white-space: normal;
    line-height: 1.2;
  }

