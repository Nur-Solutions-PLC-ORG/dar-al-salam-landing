---
/** Homes (DESIGN §5.5). M1 stub: heading only; built in M3. */
import Eyebrow from '../ui/Eyebrow.astro';
import { sections } from '../../data/sections';
import { emph, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
---

<section id="homes" class:list={['section', '']} aria-labelledby="homes-title" data-header-theme="light">
  <div class="container">
    <Eyebrow n={sections.homes.n} label={t.homes.eyebrow} />
    <h2 id="homes-title" class="h2 stub__title" data-split set:html={emph(t.homes.title)} />
  </div>
</section>

<style>
  .stub__title {
    margin-top: var(--space-5);
    max-width: 18ch;
  }
</style>
