---
/**
 * Why Dar Al Salam + flexible payment (DESIGN §5.7 rev 2). Navy. Only what the plans and brief support;
 * no numbers or percentages for payment. Part A has a visually-hidden H2 so the heading order stays valid.
 * Rev 5: three pillars (parking became a building feature) + the building features band (exact wordings).
 */
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import { sections } from '../../data/sections';
import { site } from '../../data/site';
import { emph, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);
const p = t.payment;

// 32 px line icons, 1.25 px stroke (drawn on a 32 grid)
const icons = {
  generous: 'M5 5h22v22H5zM5 15h10v12M15 5v6M21 15h6M15 21h4',
  balconies: 'M6 4h20v14H6zM16 4v14M3 18h26M5 18v10M27 18v10M9 22v6M13 22v6M19 22v6M23 22v6M3 28h26',
  lifts: 'M7 4h18v24H7zM16 4v24M10 13l2.5-3 2.5 3M17 19l2.5 3 2.5-3',
} as const;
const pillars = (['generous', 'balconies', 'lifts'] as const).map((k) => ({ k, ...p.pillars[k], d: icons[k] }));

// Building features (DESIGN §5.7 rev 5): our own 24-grid line icons, exact labels from the dictionary
const featureIcons: Record<(typeof site.features)[number], string> = {
  garbageChute:
    '<path d="M9 3v18M15 3v18M3 7h6M15 7h6M3 13h6M15 13h6M3 19h6M15 19h6M12 9v6M10.5 13.5 12 15l1.5-1.5"/>',
  standbyLift:
    '<rect x="3" y="4" width="8" height="16" rx="1"/><path d="M5.5 10.5 7 9l1.5 1.5M5.5 13.5 7 15l1.5-1.5"/><rect x="13" y="4" width="8" height="16" rx="1" stroke-dasharray="2 2"/>',
  undergroundWater:
    '<path d="M8 9V4h8v5M2 9h20M12 12.5c2.4 3 3.6 4.9 3.6 6.3a3.6 3.6 0 0 1-7.2 0c0-1.4 1.2-3.3 3.6-6.3z"/>',
  parking: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M9.5 17V7H13a3 3 0 0 1 0 6H9.5"/>',
};
const features = site.features.map((k) => ({ k, label: t.features.items[k], svg: featureIcons[k] }));
const steps = [p.steps.reserve, p.steps.overTime, p.steps.paid];
---

<section id="payment" class="section theme-dusk payment" aria-labelledby="payment-why" data-header-theme="dark">
  <div class="container">
    <Eyebrow n={sections.payment.n} label={p.eyebrow} />
    <h2 id="payment-why" class="visually-hidden">{p.eyebrow}</h2>
    <ul role="list" class="pillars" data-pillars>
      {
        pillars.map((x) => (
          <li class="pillar">
            <svg class="pillar__icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
              <path d={x.d} />
            </svg>
            <h3 class="pillar__title">{x.title}</h3>
            <p class="small muted">{x.body}</p>
          </li>
        ))
      }
    </ul>

    {
      features.length > 0 && (
        <div class="features">
          <h3 class="eyebrow features__title" data-eyebrow>
            <span>{t.features.title}</span>
            <span class="eyebrow__rule" aria-hidden="true" />
          </h3>
          <ul role="list" class="features__list" data-features>
            {features.map((x) => (
              <li class="feature">
                <svg
                  class="feature__icon"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={x.svg}
                />
                <span class="feature__label">{x.label}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="plan">
      <h2 class="h2 plan__title" data-split set:html={emph(p.title)} />
      <div class="steps" data-steps>
        <span class="steps__line" aria-hidden="true"><span data-steps-line></span></span>
        <ol class="steps__list" aria-label={p.stepsLabel}>
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__dot" aria-hidden="true" data-step-dot>
                <span />
              </span>
              <span class="step__n tabular" aria-hidden="true">
                0{i + 1}
              </span>
              <h3 class="step__title">{s.title}</h3>
              <p class="small muted">{s.body}</p>
            </li>
          ))
        }
        </ol>
      </div>
      <div class="plan__cta">
        <Button href="#enquire" magnetic>{t.cta.requestPricing}</Button>
        <p class="small muted">{p.smallPrint}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .pillars {
    display: grid;
    gap: var(--space-7) var(--gutter);
    margin-top: var(--space-7);
  }

  /* ---------- building features band (rev 5): denser than the pillars, a spec list ---------- */
  .features {
    --_hair: color-mix(in srgb, var(--gold-500) 35%, transparent);
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
    padding-bottom: var(--space-9);
  }

  .features__title {
    margin: 0;
  }

  /* hairlines between cells = the list background showing through 1 px gaps */
  .features__list {
    display: grid;
    gap: 1px;
    background: var(--_hair);
    border-block: 1px solid var(--_hair);
  }

  .feature {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 56px;
    padding: 20px 24px;
    background: var(--bg);
  }

  .feature__icon {
    width: 28px;
    height: 28px;
    flex: none;
    color: var(--gold-500);
  }

  .feature__icon :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .feature__label {
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--text);
  }

  @media (min-width: 640px) {
    .features__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .features__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .pillar {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .pillar__icon {
    width: 32px;
    height: 32px;
    color: var(--gold-500);
  }

  .pillar__title {
    font-size: var(--fs-h3);
  }

  .plan {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--space-9);
  }

  .plan__title {
    max-width: 16ch;
  }

  /* steps: vertical on mobile, horizontal hairline timeline from 768 */
  .steps {
    position: relative;
    padding: 0 0 0 var(--space-7);
  }

  .steps__list {
    display: grid;
    gap: var(--space-6);
    list-style: none;
    padding: 0;
  }

  .steps__line {
    position: absolute;
    left: 7px;
    top: 8px;
    bottom: 8px;
    width: 1px;
    background: var(--line);
  }

  .steps__line span {
    position: absolute;
    inset: 0;
    background: var(--gold-500);
    transform-origin: top;
  }

  .step {
    position: relative;
    display: grid;
    gap: var(--space-2);
  }

  .step__dot {
    position: absolute;
    left: calc(-1 * var(--space-7));
    top: 2px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    border: 1px solid var(--gold-500);
    background: var(--bg);
    display: grid;
    place-items: center;
  }

  .step__dot span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .step__n {
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--accent-text);
  }

  .step__title {
    font-size: var(--fs-h3);
  }

  .plan__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .pillars {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .steps {
      padding: var(--space-7) 0 0;
    }

    .steps__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--gutter);
    }

    .steps__line {
      left: 0;
      right: 0;
      top: 7px;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .steps__line span {
      transform-origin: left;
    }

    .step__dot {
      left: 0;
      top: calc(-1 * var(--space-7));
    }
  }
</style>
