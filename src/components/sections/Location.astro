---
/**
 * Location (DESIGN §5.6 rev 7, rev 8.5 user request). The visual is always the Leaflet satellite map (Esri World
 * Imagery) with a pin at the client's coordinates, loaded by src/scripts/location-map.ts when the section is within
 * 800 px (no cost at page load). The stylised diagram is gone. With no JS, before the map is ready, or when the tiles
 * fail, the frame shows a small fallback card instead: the pin, the name, and the two Maps links. The caption belongs
 * to the satellite image only. Landmarks are never plotted on the map; the list below is the accessible version.
 */
import Eyebrow from '../ui/Eyebrow.astro';
import { sections } from '../../data/sections';
import { directionsHref, esriTileUrl, mapsHref, site } from '../../data/site';
import { emph, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = getDict(lang);

// The client's pin (site.location.mapsUrl) wins; without it, search the office address if set, else the brief's query
const mapsQuery = site.contact.address.length ? site.contact.address.join(', ') : site.location.mapsQuery;
const l = t.location;
const ctas = [
  { href: directionsHref(), label: l.directions, primary: true },
  { href: mapsHref(mapsQuery), label: l.openMaps, primary: false },
].filter((c) => c.href);
// everything the map chunk needs, so it carries no dictionary of its own
const mapConfig = {
  lat: site.location.lat,
  lng: site.location.lng,
  tiles: esriTileUrl(),
  t: {
    region: l.mapRegion,
    card: l.pinCard,
    two: l.twoFingers,
    in: l.zoomIn,
    out: l.zoomOut,
    centre: l.recentre,
  },
};
---

<section id="location" class="section section--alt location" aria-labelledby="location-title" data-header-theme="light">
  <div class="container grid location__grid">
    <div class="location__text">
      <Eyebrow n={sections.location.n} label={t.location.eyebrow} />
      <h2 id="location-title" class="h2 location__title" data-split set:html={emph(t.location.title)} />
      <p class="lead" data-reveal>{t.location.lead}</p>
      <div class="location__ctas">
        {
          ctas.map((c) => (
            <a class:list={['btn', { 'btn--secondary': !c.primary }]} href={c.href} target="_blank" rel="noopener">
              {c.primary ? (
                <svg class="location__glyph" viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                  <circle cx="4" cy="3.5" r="1.75" />
                  <circle cx="12" cy="12.5" r="1.75" />
                  <path d="M4 5.25v2.5a2 2 0 0 0 2 2h4a2 2 0 0 1 2 2v-.75" stroke-linecap="round" />
                </svg>
              ) : (
                <svg class="location__glyph" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                  <path d="M8 1.5a4.2 4.2 0 0 1 2.4 7.65L12 14.5H4l1.6-5.35A4.2 4.2 0 0 1 8 1.5Z" />
                </svg>
              )}
              <span class="btn__inner">
                <span class="btn__text">{c.label}</span>
                <span class="btn__text btn__text--dup" aria-hidden="true">
                  {c.label}
                </span>
              </span>
              <svg class="btn__icon" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M7 4h9v9M16 4 5 15" />
              </svg>
              <span class="visually-hidden"> {t.a11y.newTab}</span>
            </a>
          ))
        }
      </div>
    </div>

    <figure
      class="location__map arch arch--soft"
      data-map
      data-map-config={JSON.stringify(mapConfig)}
    >
      <div class="arch__media location__media">
        <!-- fallback (no JS, before the map is ready, tile failure): hidden by location-map.ts once the map shows -->
        <div class="location__fallback theme-dusk" data-map-fallback>
          <div class="location__card">
            <svg class="location__card-pin" viewBox="0 0 40 52" aria-hidden="true">
              <path d="M20 50C14 40 3 31 3 20a17 17 0 1 1 34 0c0 11-11 20-17 30Z" />
              <path class="location__card-key" transform="translate(20 20) scale(1.4)" d="M0-8a4.6 4.6 0 0 1 2.6 8.4L4.4 8h-8.8l1.8-7.6A4.6 4.6 0 0 1 0-8Z" />
            </svg>
            <p class="location__card-title">{l.pinCard}</p>
            <ul class="location__card-links" role="list">
              {
                ctas.map((c) => (
                  <li>
                    <a class:list={['btn', { 'btn--secondary': !c.primary }]} href={c.href} target="_blank" rel="noopener">
                      {c.label}
                      <span class="visually-hidden"> {t.a11y.newTab}</span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
      <figcaption class="small muted location__caption" data-map-caption hidden>{l.captionMap}</figcaption>
    </figure>

    <div class="location__aside">
      <h3 class="location__nearby">{t.location.nearby}</h3>
      <ul class="location__list" role="list" data-reveal="stagger">
        {site.location.landmarks.map((k) => <li>{t.location.landmarks[k]}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .location__grid {
    row-gap: var(--space-7);
    align-items: start;
  }

  .location__text,
  .location__map,
  .location__aside {
    grid-column: 1 / -1;
  }

  .location__text {
    display: grid;
    gap: var(--space-5);
  }

  .location__title {
    max-width: 14ch;
  }

  .location__map {
    margin: 0;
    width: 100%;
    max-width: 560px;
    justify-self: center;
  }

  .location__media {
    aspect-ratio: 4 / 5;
    background: var(--ivory-50);
    height: auto;
  }

  /* the fallback (rev 8.5): navy-900 filling the frame's box (no layout shift when the live map covers it) */
  .location__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 30% var(--space-5) var(--space-5); /* clear of the arch's dome */
    background: var(--navy-900);
    color: var(--ivory-50);
  }

  .location__card {
    display: grid;
    justify-items: center;
    gap: var(--space-4);
    width: min(100%, 320px);
    text-align: center;
  }

  .location__card-pin {
    width: 40px;
    height: 52px;
    fill: var(--gold-500);
    stroke: var(--ivory-50);
    stroke-width: 2;
  }

  .location__card-key {
    fill: var(--navy-900);
    stroke: none;
  }

  .location__card-title {
    font: 600 17px/1.3 var(--font-body);
  }

  .location__card-links {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }

  .location__card-links .btn {
    width: 100%;
    white-space: normal;
  }

  .location__caption {
    margin-top: var(--space-3);
    text-align: center;
  }

  .location__aside {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }

  .location__nearby {
    font-family: var(--font-body);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  :global(:lang(am)) .location__nearby {
    letter-spacing: 0;
    font-size: 0.8125rem;
  }

  /* phones: full width, stacked, Directions first; side by side from 640 */
  .location__ctas {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  .location__ctas .btn {
    white-space: normal;
    text-align: center;
  }

  .location__glyph {
    position: relative;
    z-index: 1;
    width: 16px;
    height: 16px;
    flex: none;
  }

  @media (min-width: 640px) {
    .location__ctas {
      display: flex;
      flex-wrap: wrap;
    }
  }

  /* the live map fills the frame (no layout shift); built by location-map.ts */
  .location__media :global(.lmap) {
    position: absolute;
    inset: 0;
  }

  .location__list {
    display: grid;
    gap: var(--space-3);
  }

  /* keyhole bullets (DESIGN §3.4 motif) */
  .location__list li {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .location__list li::before {
    content: '';
    flex: none;
    width: 9px;
    height: 13px;
    background: var(--accent);
    clip-path: path('M4.5 0a3.6 3.6 0 0 1 2 6.6L8.3 13H.7l1.8-6.4A3.6 3.6 0 0 1 4.5 0Z');
    transform: translateY(1px);
  }

  @media (min-width: 1024px) {
    .location__text {
      grid-column: 9 / 13;
      grid-row: 1;
    }

    .location__map {
      grid-column: 1 / 8;
      grid-row: 1 / span 2;
      max-width: none;
    }

    .location__aside {
      grid-column: 9 / 13;
      grid-row: 2;
    }
  }
</style>

<script>
  import { initLocationMap } from '../../scripts/location-loader';
  initLocationMap();
</script>
