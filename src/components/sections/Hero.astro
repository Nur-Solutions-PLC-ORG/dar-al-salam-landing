---
/**
 * Hero (DESIGN §5.1 rev 6): the tower film as a shaded background.
 * Layers inside #top: .hero__bg (poster <img> = LCP, + the muted loop; intro scale and S1 move it)
 * > .hero__shade (static navy gradients, verified contrast) > .hero__grain (static tile) > .hero__inner.
 * The entrance is CSS keyframes on the intro clock (--t0), so the headline never depends on JS.
 * src/scripts/hero-bg.ts loads the loop at DOMContentLoaded, only under the §5.1 conditions.
 */
import Button from '../ui/Button.astro';
import { emph, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
// pre-split H1 lines ("|" in the dictionary); each line is masked and revealed by CSS
const lines = t.hero.title.split('|');
---

<section id="top" class="hero theme-dusk" aria-labelledby="hero-title" data-header-theme="dark" data-hero>
  <div class="hero__bg" aria-hidden="true" data-hero-bg>
    <picture>
      <source type="image/webp" srcset="/video/hero-bg-poster.webp" />
      <img
        class="hero__poster"
        src="/video/hero-bg-poster.jpg"
        width="640"
        height="352"
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <!-- no poster attribute: the <img> above is the poster (a poster attribute would fetch it twice) -->
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      {...{ disableremoteplayback: true } /* valid HTML, missing from Astro's video types */}
      aria-hidden="true"
      tabindex="-1"
      data-hero-video></video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__film" data-hero-film>
      <!-- no JS: film.mp4 in the browser's player; with JS: the film dialog (circle reveal from the disc) -->
      <a class="hero__play" href="/video/film.mp4" aria-haspopup="dialog" data-film-open data-hero-play data-cursor="play">
        <span class="hero__play-disc" aria-hidden="true"><span class="hero__play-ring"></span></span>
        <!-- two items: at ≥ 1024 the label is inline-flex, which trims the space before "0:41"; gap restores it -->
        <span class="hero__play-label"><span>{t.film.watch} ·</span> <span class="tabular">{t.film.duration}</span></span>
        <span class="visually-hidden">{t.film.openSr}</span>
      </a>
    </div>
    <div class="hero__content" data-hero-copy>
      <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {
          lines.map((line, i) => (
            <span class="line" style={`--line: ${i}`}>
              <span set:html={emph(line)} />
            </span>
          ))
        }
      </h1>
      <p class="lead hero__lead">{t.hero.lead}</p>
      <div class="hero__ctas">
        <Button href="#enquire" magnetic>{t.cta.bookVisit}</Button>
        <Button href="#explore" variant="secondary" icon="down">{t.cta.explore}</Button>
      </div>
    </div>

    <div class="hero__controls" role="group" aria-label={t.film.bgGroup}>
      <!-- WCAG 2.2.2: shown only when the loop may play; the label swaps (no aria-pressed) -->
      <button
        type="button"
        class="hero__ctl"
        data-bg-toggle
        data-label-pause={t.film.bgPause}
        data-label-play={t.film.bgPlay}
        hidden
      >
        <span class="visually-hidden" data-bg-toggle-label>{t.film.bgPause}</span>
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path class="hero__glyph-pause" d="M4 2.5h2.6v11H4zM9.4 2.5H12v11H9.4z"></path>
          <path class="hero__glyph-play" d="M4.5 2v12L14 8z"></path>
        </svg>
      </button>
      <!-- rev 5 sound toggle, moved: constant name, state in aria-pressed, aria-hidden tooltip; shown by film.ts -->
      <button
        type="button"
        class="hero__ctl hero__sound"
        aria-pressed="false"
        aria-label={t.film.music}
        data-film-sound
        data-state="off"
        data-label-on={t.film.soundOn}
        data-label-off={t.film.soundOff}
        data-label-error={t.film.soundError}
        hidden
      >
        <span class="hero__bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="hero__slash" aria-hidden="true"></span>
        <span class="hero__tip" aria-hidden="true" data-film-sound-tip>{t.film.soundOff}</span>
      </button>
    </div>
  </div>
  <div class="hero__cue" aria-hidden="true">
    <span class="hero__cue-line"></span>
    <span>{t.hero.scroll}</span>
  </div>
</section>

<style>
  .hero {
    --ink: 11 18 32; /* navy-950 */
    position: relative;
    overflow: clip;
    isolation: isolate;
    background: var(--navy-950);
    color: var(--ivory-50);
  }

  /* ---------- layers ---------- */
  .hero__bg,
  .hero__shade,
  .hero__grain {
    position: absolute;
    inset: 0;
  }

  .hero__bg {
    z-index: 0;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%; /* identical on both, so the cross-fade lines up */
  }

  /* the loop fades in over the poster on its first frame (power2.inOut 1.2 s); out over 0.6 s on auto-stop */
  .hero__video {
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.455, 0.03, 0.515, 0.955);
  }

  .hero__video.is-playing {
    opacity: 1;
    transition-duration: 1.2s;
  }

  /* < 1024: top-and-floor gradient; the content scrim is anchored to the content (below) */
  .hero__shade {
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(var(--ink) / 0.78) 0,
      rgb(var(--ink) / 0.62) 64px,
      rgb(var(--ink) / 0.3) 25%,
      rgb(var(--ink) / 0.3) 100%
    );
  }

  .hero__grain {
    z-index: 2;
    background: url(/img/grain.png) 0 0 / 128px 128px repeat;
    opacity: 0.35;
    pointer-events: none;
  }

  /* ---------- content: < 1024 portrait layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: var(--header-h);
    padding-bottom: max(16px, env(safe-area-inset-bottom));
  }

  /* the film zone: the free band between header and text; the play control sits centred in it */
  .hero__film {
    flex: 1;
    min-height: 72px;
    display: grid;
    place-items: center;
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 560px;
  }

  .hero__content::before {
    content: '';
    position: absolute;
    left: -100vw;
    right: -100vw;
    top: -120px;
    bottom: -100vh;
    z-index: -1;
    background: linear-gradient(180deg, rgb(var(--ink) / 0) 0, rgb(var(--ink) / 0.72) 120px, rgb(var(--ink) / 0.8) 100%);
    pointer-events: none;
  }

  /* hero text: ivory, sand-200 or gold-400 only (never --text-muted), for the verified contrast */
  .hero__eyebrow {
    color: var(--gold-400);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: 0.95;
    letter-spacing: -0.015em;
    max-width: 14ch;
    color: var(--ivory-50);
  }

  :global(:lang(am)) .hero__title {
    line-height: 1.15;
    max-width: 16ch;
    letter-spacing: 0; /* design QA #12: no display tracking on Ethiopic */
  }

  :global(:lang(am)) .hero__cue {
    letter-spacing: 0;
  }

  .hero__title .line {
    display: block;
    overflow: clip;
    /* room for descenders and the italic overhang inside the mask */
    padding-block-end: 0.08em;
    margin-block-end: -0.08em;
    overflow-clip-margin: 0.1em;
  }

  .hero__title .line > span {
    display: block;
  }

  .hero__lead {
    color: var(--sand-200);
    max-width: 34ch;
  }

  .hero__ctas {
    display: grid;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-2);
  }

  .hero__ctas :global(.btn) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
      width: auto;
    }

    .hero__ctas :global(.btn) {
      width: auto;
    }
  }

  .hero__cue {
    display: none;
  }

  /* ---------- play control: < 1024 a 48 px pill (36 px disc + label), centred in the film zone ---------- */
  .hero__play {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 6px 18px 6px 6px;
    border-radius: var(--radius-pill);
    background: rgb(var(--ink) / 0.72);
    color: var(--ivory-50);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    outline: none;
  }

  .hero__play:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  /* the entrance scales from the disc centre */
  .hero__play {
    transform-origin: 24px 50%;
  }

  .hero__play-disc {
    position: relative;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--gold-500);
    transition: transform 0.45s var(--ease-out);
  }

  /* the triangle, optically centred (nudged right) */
  .hero__play-disc::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 32%;
    height: 36%;
    transform: translateX(8%);
    background: var(--navy-950);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  .hero__play-ring {
    display: none;
  }

  /* ---------- controls cluster: two 44 px circles, 8 px apart (pause/play, then sound) ---------- */
  /* the row's height is reserved: the buttons are revealed by JS after first paint, and the content is
     bottom-anchored, so a growing row would shift the whole hero (CLS) */
  .hero__controls {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
    min-height: 44px;
    margin-top: 16px;
    margin-bottom: env(safe-area-inset-bottom);
  }

  .hero__ctl {
    position: relative;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgb(var(--ink) / 0.55);
    box-shadow: inset 0 0 0 1px rgb(251 247 242 / 0.35);
    color: var(--ivory-50);
  }

  .hero__ctl[hidden] {
    display: none;
  }

  .hero__ctl:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .hero__ctl svg {
    width: 16px;
    height: 16px;
  }

  .hero__glyph-play,
  [data-paused] .hero__glyph-pause {
    display: none;
  }

  [data-paused] .hero__glyph-play {
    display: inline;
  }

  /* sound glyph: three 2 px bars (+ a slash when off); equaliser only while audio actually plays */
  .hero__bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 14px;
  }

  .hero__bars span {
    width: 2px;
    height: 14px;
    background: currentColor;
    transform-origin: bottom;
    transform: scaleY(0.25);
  }

  .hero__slash {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1.5px;
    height: 22px;
    background: currentColor;
    transform: rotate(-45deg);
  }

  .hero__sound:not([data-state='off']) .hero__slash {
    display: none;
  }

  .hero__sound[data-state='loading'] .hero__bars {
    animation: sound-loading 0.8s ease-in-out infinite alternate;
  }

  .hero__sound[data-state='on'] .hero__bars span {
    animation: eq 0.9s ease-in-out infinite alternate;
    animation-play-state: paused;
  }

  .hero__sound[data-state='on'] .hero__bars span:nth-child(2) {
    animation-duration: 1.1s;
  }

  .hero__sound[data-state='on'] .hero__bars span:nth-child(3) {
    animation-duration: 0.7s;
  }

  .hero__sound[data-state='on'][data-playing] .hero__bars span {
    animation-play-state: running;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__sound[data-state='on'] .hero__bars span {
      animation: none;
      transform: scaleY(0.6);
    }

    .hero__sound[data-state='on'] .hero__bars span:nth-child(2) {
      transform: scaleY(1);
    }

    .hero__sound[data-state='on'] .hero__bars span:nth-child(3) {
      transform: scaleY(0.45);
    }
  }

  @keyframes eq {
    from {
      transform: scaleY(0.3);
    }
    to {
      transform: scaleY(1);
    }
  }

  @keyframes sound-loading {
    from {
      opacity: 0.5;
    }
    to {
      opacity: 1;
    }
  }

  /* state tooltip ("Sound off" / "Sound on"), on hover and keyboard focus; the state is announced by aria-pressed */
  .hero__tip {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    background: var(--navy-950);
    color: var(--ivory-50);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
    transform: translateX(-50%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s var(--ease-out);
  }

  .hero__sound:is(:hover, :focus-visible) .hero__tip {
    opacity: 1;
  }

  /* ---------- ≥ 1024: landscape layout on the 12-column grid ---------- */
  @media (min-width: 1024px) {
    .hero {
      max-height: 1200px;
    }

    .hero__shade {
      background:
        linear-gradient(90deg, rgb(var(--ink) / 0.8) 0%, rgb(var(--ink) / 0.7) 48%, rgb(var(--ink) / 0.3) 72%, rgb(var(--ink) / 0.15) 100%),
        linear-gradient(180deg, rgb(var(--ink) / 0.7) 0, rgb(var(--ink) / 0.45) 72px, rgb(var(--ink) / 0) 200px),
        linear-gradient(0deg, rgb(var(--ink) / 0.65) 0, rgb(var(--ink) / 0) 28%),
        radial-gradient(130% 100% at 70% 45%, rgb(var(--ink) / 0) 50%, rgb(var(--ink) / 0.4) 100%);
    }

    .hero__inner {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: center;
      max-height: 1200px;
      /* the bottom band holds the scroll cue and the controls (32 + 44 px): content centres above it */
      padding-bottom: 96px;
    }

    /* text: cols 1–6 and never past 48% of the hero width (where the text-side shade is ≥ 0.70) */
    .hero__content {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: center;
      max-width: min(100%, calc(48vw - max(var(--margin), (100vw - var(--container)) / 2)));
      gap: var(--space-5);
    }

    .hero__content::before {
      display: none;
    }

    .hero__film {
      grid-column: 8 / 13;
      grid-row: 1;
      align-self: stretch;
    }

    /* play: an 88 px disc (104 at ≥ 1600) with a ring, 12 px above a label pill */
    .hero__play {
      transform-origin: 50% 44px;
      flex-direction: column;
      gap: 12px;
      min-height: 0;
      padding: 0;
      background: none;
      border-radius: 0;
    }

    .hero__play:focus-visible {
      outline: none;
    }

    .hero__play:focus-visible .hero__play-disc {
      outline: 2px solid var(--focus);
      outline-offset: 12px;
    }

    .hero__play-disc {
      width: 88px;
      height: 88px;
    }

    .hero__play-disc::before {
      width: 28px;
      height: 28px;
      transform: translateX(2px);
    }

    .hero__play-ring,
    .hero__play-disc::after {
      position: absolute;
      inset: -9.5px;
      border: 1.5px solid rgb(251 247 242 / 0.7);
      border-radius: 50%;
      pointer-events: none;
    }

    .hero__play-ring {
      display: block;
      transition: transform 0.45s var(--ease-out);
    }

    .hero__play-label {
      display: inline-flex;
      align-items: center;
      gap: 0.3em;
      min-height: 36px;
      padding: 0 16px;
      border-radius: var(--radius-pill);
      background: rgb(var(--ink) / 0.72);
    }

    /* the controls stay put at the bottom right, aligned to the container edge (mirror of the scroll cue) */
    .hero__controls {
      position: absolute;
      z-index: 3;
      right: max(var(--margin), calc((100% - var(--container)) / 2));
      bottom: 32px;
      margin: 0 0 env(safe-area-inset-bottom);
    }

    .hero__cue {
      position: absolute;
      z-index: 3;
      bottom: 32px;
      left: max(var(--margin), calc((100% - var(--container)) / 2));
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      font-size: var(--fs-eyebrow);
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--sand-200);
    }

    .hero__cue-line {
      display: block;
      width: 1px;
      height: 40px;
      background: var(--gold-400);
      transform-origin: top;
    }
  }

  @media (min-width: 1600px) {
    .hero__play-disc {
      width: 104px;
      height: 104px;
    }
  }

  @media (min-width: 1024px) and (hover: hover) and (pointer: fine) {
    .hero__play:hover .hero__play-disc {
      transform: scale(1.08);
    }

    .hero__play:hover .hero__play-ring {
      transform: scale(1.15);
    }
  }

  /* idle "breath" (S14 pulse): only while the background actually plays (off-screen, dialog, paused → stopped) */
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .hero__play-disc::after {
      content: '';
      opacity: 0;
    }

    .hero[data-bg-playing] .hero__play-disc::after {
      animation: breath 2.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
    }
  }

  @keyframes breath {
    from {
      transform: scale(1);
      opacity: 0.7;
    }
    to {
      transform: scale(1.25);
      opacity: 0;
    }
  }

  /* ---------- Entrance (CSS, DESIGN §7.2 rev 6; t0 = 0.35 s with the curtain, 0 without) ----------
     Item 6 (LCP): the H1 lines start at t0 + 0.10 (+0.06 per line) and the lead at t0 + 0.15, i.e. ≤ 0.5 s
     with the curtain; the play control, controls and cue keep their later absolute times (1.55 / 1.8 / 1.9 s). */
  @media (prefers-reduced-motion: no-preference) {
    .hero__play {
      animation: play-in 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 1.2s);
    }

    .hero__controls {
      animation: rise-sm 0.5s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 1.45s);
    }

    .hero__bg {
      animation: hero-bg-in 1.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: var(--t0, 0s);
    }

    .hero__eyebrow {
      animation: rise 0.6s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.05s);
    }

    .hero__title .line > span {
      animation: title-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.1s + var(--line, 0) * 0.06s);
    }

    /* the lead is the LCP element (the full-viewport poster is not a candidate). Chrome records a compositor
       opacity animation from 0 only when it ends, so the lead fades from 0.2: painted, and counted, at once */
    .hero__lead {
      animation: rise-lead 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.15s);
    }

    .hero__ctas {
      animation: rise 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.22s);
    }

    .hero__cue-line {
      animation: cue 1.6s var(--ease-inout) infinite;
      animation-delay: calc(var(--t0, 0s) + 1.55s);
    }
  }

  @keyframes play-in {
    from {
      opacity: 0;
      transform: scale(0.85);
    }
  }

  @keyframes rise-sm {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  @keyframes hero-bg-in {
    from {
      transform: scale(1.12);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes rise-lead {
    from {
      opacity: 0.2;
      transform: translateY(14px);
    }
  }

  @keyframes title-in {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    50.1% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
</style>

<script>
  import { initHeroBg } from '../../scripts/hero-bg';
  initHeroBg();
</script>
