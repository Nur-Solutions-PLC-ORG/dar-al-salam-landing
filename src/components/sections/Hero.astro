---
/**
 * Hero (DESIGN §5.1 rev 6): the tower film as a shaded background.
 * Layers inside #top: .hero__bg (poster <img> = LCP, + the muted loop; intro scale and S1 move it)
 * > .hero__shade (static navy gradients, verified contrast) > .hero__grain (static tile) > .hero__inner.
 * The entrance is CSS keyframes on the intro clock (--t0), so the headline never depends on JS.
 * src/scripts/hero-bg.ts loads the loop at DOMContentLoaded, only under the §5.1 conditions.
 */
import Button from '../ui/Button.astro';
import { emph, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
// pre-split H1 lines ("|" in the dictionary); each line is masked and revealed by CSS
const lines = t.hero.title.split('|');
---

<section id="top" class="hero theme-dusk" aria-labelledby="hero-title" data-header-theme="dark" data-hero>
  <div class="hero__bg" aria-hidden="true" data-hero-bg>
    <picture>
      <source type="image/webp" srcset="/video/hero-bg-poster.webp" />
      <img
        class="hero__poster"
        src="/video/hero-bg-poster.jpg"
        width="640"
        height="352"
        alt=""
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <!-- no poster attribute: the <img> above is the poster (a poster attribute would fetch it twice) -->
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      {...{ disableremoteplayback: true } /* valid HTML, missing from Astro's video types */}
      aria-hidden="true"
      tabindex="-1"
      data-hero-video></video>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>
  <div class="hero__grain" aria-hidden="true"></div>

  <div class="container hero__inner">
    <div class="hero__film" data-hero-film></div>
    <div class="hero__content" data-hero-copy>
      <p class="eyebrow hero__eyebrow">{t.hero.eyebrow}</p>
      <h1 id="hero-title" class="hero__title">
        {
          lines.map((line, i) => (
            <span class="line" style={`--line: ${i}`}>
              <span set:html={emph(line)} />
            </span>
          ))
        }
      </h1>
      <p class="lead hero__lead">{t.hero.lead}</p>
      <div class="hero__ctas">
        <Button href="#enquire" magnetic>{t.cta.bookVisit}</Button>
        <Button href="#explore" variant="secondary" icon="down">{t.cta.explore}</Button>
      </div>
    </div>
  </div>
  <div class="hero__cue" aria-hidden="true">
    <span class="hero__cue-line"></span>
    <span>{t.hero.scroll}</span>
  </div>
</section>

<style>
  .hero {
    --ink: 11 18 32; /* navy-950 */
    position: relative;
    overflow: clip;
    isolation: isolate;
    background: var(--navy-950);
    color: var(--ivory-50);
  }

  /* ---------- layers ---------- */
  .hero__bg,
  .hero__shade,
  .hero__grain {
    position: absolute;
    inset: 0;
  }

  .hero__bg {
    z-index: 0;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%; /* identical on both, so the cross-fade lines up */
  }

  /* the loop fades in over the poster on its first frame (power2.inOut 1.2 s); out over 0.6 s on auto-stop */
  .hero__video {
    opacity: 0;
    transition: opacity 0.6s cubic-bezier(0.455, 0.03, 0.515, 0.955);
  }

  .hero__video.is-playing {
    opacity: 1;
    transition-duration: 1.2s;
  }

  /* < 1024: top-and-floor gradient; the content scrim is anchored to the content (below) */
  .hero__shade {
    z-index: 1;
    background: linear-gradient(
      180deg,
      rgb(var(--ink) / 0.78) 0,
      rgb(var(--ink) / 0.62) 64px,
      rgb(var(--ink) / 0.3) 25%,
      rgb(var(--ink) / 0.3) 100%
    );
  }

  .hero__grain {
    z-index: 2;
    background: url(/img/grain.png) 0 0 / 128px 128px repeat;
    opacity: 0.35;
    pointer-events: none;
  }

  /* ---------- content: < 1024 portrait layout ---------- */
  .hero__inner {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: var(--header-h);
    padding-bottom: max(16px, env(safe-area-inset-bottom));
  }

  /* the film zone: the free band between header and text; the play control sits centred in it */
  .hero__film {
    flex: 1;
    min-height: 72px;
    display: grid;
    place-items: center;
  }

  .hero__content {
    position: relative;
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    max-width: 560px;
  }

  .hero__content::before {
    content: '';
    position: absolute;
    left: -100vw;
    right: -100vw;
    top: -120px;
    bottom: -100vh;
    z-index: -1;
    background: linear-gradient(180deg, rgb(var(--ink) / 0) 0, rgb(var(--ink) / 0.72) 120px, rgb(var(--ink) / 0.8) 100%);
    pointer-events: none;
  }

  /* hero text: ivory, sand-200 or gold-400 only (never --text-muted), for the verified contrast */
  .hero__eyebrow {
    color: var(--gold-400);
  }

  .hero__title {
    font-size: var(--fs-display);
    line-height: 0.95;
    letter-spacing: -0.015em;
    max-width: 14ch;
    color: var(--ivory-50);
  }

  :global(:lang(am)) .hero__title {
    line-height: 1.15;
    max-width: 16ch;
    letter-spacing: 0; /* design QA #12: no display tracking on Ethiopic */
  }

  :global(:lang(am)) .hero__cue {
    letter-spacing: 0;
  }

  .hero__title .line {
    display: block;
    overflow: clip;
    /* room for descenders and the italic overhang inside the mask */
    padding-block-end: 0.08em;
    margin-block-end: -0.08em;
    overflow-clip-margin: 0.1em;
  }

  .hero__title .line > span {
    display: block;
  }

  .hero__lead {
    color: var(--sand-200);
    max-width: 34ch;
  }

  .hero__ctas {
    display: grid;
    gap: var(--space-3);
    width: 100%;
    margin-top: var(--space-2);
  }

  .hero__ctas :global(.btn) {
    width: 100%;
  }

  @media (min-width: 480px) {
    .hero__ctas {
      display: flex;
      flex-wrap: wrap;
      width: auto;
    }

    .hero__ctas :global(.btn) {
      width: auto;
    }
  }

  .hero__cue {
    display: none;
  }

  /* ---------- ≥ 1024: landscape layout on the 12-column grid ---------- */
  @media (min-width: 1024px) {
    .hero {
      max-height: 1200px;
    }

    .hero__shade {
      background:
        linear-gradient(90deg, rgb(var(--ink) / 0.8) 0%, rgb(var(--ink) / 0.7) 48%, rgb(var(--ink) / 0.3) 72%, rgb(var(--ink) / 0.15) 100%),
        linear-gradient(180deg, rgb(var(--ink) / 0.7) 0, rgb(var(--ink) / 0.45) 72px, rgb(var(--ink) / 0) 200px),
        linear-gradient(0deg, rgb(var(--ink) / 0.65) 0, rgb(var(--ink) / 0) 28%),
        radial-gradient(130% 100% at 70% 45%, rgb(var(--ink) / 0) 50%, rgb(var(--ink) / 0.4) 100%);
    }

    .hero__inner {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: center;
      max-height: 1200px;
      padding-bottom: 0;
    }

    /* text: cols 1–6 and never past 48% of the hero width (where the text-side shade is ≥ 0.70) */
    .hero__content {
      grid-column: 1 / 7;
      grid-row: 1;
      align-self: center;
      max-width: min(100%, calc(48vw - max(var(--margin), (100vw - var(--container)) / 2)));
      gap: var(--space-5);
    }

    .hero__content::before {
      display: none;
    }

    .hero__film {
      grid-column: 8 / 13;
      grid-row: 1;
      align-self: stretch;
    }

    .hero__cue {
      position: absolute;
      z-index: 3;
      bottom: 32px;
      left: max(var(--margin), calc((100% - var(--container)) / 2));
      display: inline-flex;
      align-items: center;
      gap: var(--space-3);
      font-size: var(--fs-eyebrow);
      font-weight: 600;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--sand-200);
    }

    .hero__cue-line {
      display: block;
      width: 1px;
      height: 40px;
      background: var(--gold-400);
      transform-origin: top;
    }
  }

  /* ---------- Entrance (CSS, DESIGN §7.2 rev 6; t0 = 0.85 s with the curtain, 0 without) ---------- */
  @media (prefers-reduced-motion: no-preference) {
    .hero__bg {
      animation: hero-bg-in 1.8s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: var(--t0, 0s);
    }

    .hero__eyebrow {
      animation: rise 0.6s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.2s);
    }

    .hero__title .line > span {
      animation: title-in 1.1s cubic-bezier(0.16, 1, 0.3, 1) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.25s + var(--line, 0) * 0.08s);
    }

    .hero__lead {
      animation: rise 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.55s);
    }

    .hero__ctas {
      animation: rise 0.7s var(--ease-out) backwards;
      animation-delay: calc(var(--t0, 0s) + 0.63s);
    }

    .hero__cue-line {
      animation: cue 1.6s var(--ease-inout) infinite;
      animation-delay: calc(var(--t0, 0s) + 1.05s);
    }
  }

  @keyframes hero-bg-in {
    from {
      transform: scale(1.12);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes title-in {
    from {
      transform: translateY(110%);
    }
  }

  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    50.1% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
</style>

<script>
  import { initHeroBg } from '../../scripts/hero-bg';
  initHeroBg();
</script>
