---
/** The tower / House of Peace (DESIGN §5.3). Sand. Statement cols 1–7, arch cols 8–12 offset down. */
import { Picture } from 'astro:assets';
import Arch from '../ui/Arch.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import storyTower from '../../assets/generated/story-tower.jpg';
import keyplan from '../../assets/plans/keyplan-duotone.png';
import { sections } from '../../data/sections';
import { twoBedFloors } from '../../data/units';
import { emph, floorList, fmt, getDict, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);
---

<section id="story" class="section section--alt story" aria-labelledby="story-title" data-header-theme="light">
  <div class="container grid story__grid">
    <div class="story__head">
      <Eyebrow n={sections.story.n} label={t.story.eyebrow} />
      <h2 id="story-title" class="h2 story__title" data-split set:html={emph(t.story.title)} />
    </div>

    <Arch class="story__arch" outline aspect="4 / 5" data-story-arch>
      <!-- rev 6: the whole tower (a zoomed-out crop); S8 parallax toned down to ±2.5 so the roof stays in -->
      <div class="story__parallax" data-parallax-media data-parallax="2.5">
        <Picture
          src={storyTower}
          formats={['avif', 'webp']}
          widths={[480, 640, 900, 1200]}
          width={640}
          fallbackFormat="jpg"
          sizes="(min-width: 1024px) 34vw, (min-width: 768px) 50vw, 88vw"
          alt={t.story.imageAlt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </Arch>

    <div class="story__body prose" data-reveal>
      <p class="lead">{t.story.p1}</p>
      <p>{fmt(t.story.p2, { floors: floorList(twoBedFloors, lang) })}</p>
      <!-- rev 5: a second way into the film dialog, not a second player (no video here) -->
      <p class="story__film">
        <a class="link story__film-link" href="/video/film.mp4" aria-haspopup="dialog" data-film-open>
          <span class="story__film-disc" aria-hidden="true"></span>
          <span>{t.film.watch} · <span class="tabular">{t.film.duration}</span></span>
        </a>
      </p>
    </div>

    <figure class="story__keyplan" data-reveal>
      <Arch class="story__keyplan-frame" soft>
        <Picture
          src={keyplan}
          formats={['avif', 'webp']}
          widths={[240, 360, 480]}
          width={480}
          fallbackFormat="jpg"
          sizes="220px"
          alt={t.story.keyplanAlt}
          loading="lazy"
          decoding="async"
        />
      </Arch>
      <figcaption class="eyebrow">{t.story.keyplanCaption}</figcaption>
    </figure>
  </div>
</section>

<style>
  .story__film-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--tap-min);
    font-weight: 600;
  }

  /* the underline runs under the words, not the disc */
  .story__film-link::after {
    left: calc(20px + var(--space-3));
  }

  .story__film-disc {
    position: relative;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--gold-500);
  }

  .story__film-disc::before {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 7px;
    height: 8px;
    transform: translateX(1px);
    background: var(--navy-950);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }

  /* room for the dusk gradient (#explore::before) below the story's last line */
  .story {
    padding-bottom: calc(var(--section-y) + 32svh);
  }

  .story__grid {
    row-gap: var(--space-7);
    align-items: start;
  }

  .story__head,
  .story__arch,
  .story__body,
  .story__keyplan {
    grid-column: 1 / -1;
  }

  .story__head {
    display: grid;
    gap: var(--space-5);
  }

  .story__title {
    max-width: 18ch;
  }

  :global(:lang(am)) .story__title {
    max-width: 22ch;
  }

  .story__arch {
    width: min(100%, 420px);
    justify-self: center;
    margin-top: 10px;
  }

  .story__parallax {
    height: 100%;
  }

  /* media box 106% tall (inset −3% 0): room for the ±2.5% S8 drift without cropping the roof */
  .story__parallax :global(img) {
    width: 100%;
    height: 106%;
    margin-top: -3%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  .story__body {
    color: var(--text);
  }

  .story__body p:not(.lead) {
    color: var(--text-muted);
  }

  /* design QA #11: the typical floor sits under the paragraphs, 220 px, in a thin soft arch */
  .story__keyplan {
    display: grid;
    justify-items: start;
    gap: var(--space-4);
    margin: 0;
  }

  .story__keyplan-frame {
    width: 220px;
    aspect-ratio: 1549 / 2140;
  }

  .story__keyplan-frame :global(.arch__media) {
    padding: 28% 10% 8%;
    background: var(--ivory-50);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .story__keyplan-frame :global(picture),
  .story__keyplan-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .story__head {
      grid-column: 1 / 6;
    }

    .story__arch {
      grid-column: 6 / 9;
      grid-row: 1 / span 2;
      width: 100%;
      margin-top: 120px;
    }

    .story__body {
      grid-column: 1 / 6;
    }

    .story__keyplan {
      grid-column: 1 / 6;
    }
  }

  @media (min-width: 1024px) {
    .story__head {
      grid-column: 1 / 8;
    }

    .story__arch {
      grid-column: 8 / 13;
      margin-top: 120px;
    }

    .story__body {
      grid-column: 1 / 7;
    }

    .story__keyplan {
      grid-column: 1 / 7;
    }

  }
</style>
