---
import { site } from '../data/site';
import { grossRange } from '../data/units';
import { getDict, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = getDict(lang);

const facts = [
  { value: String(site.project.residentialFloors), label: t.facts.floors },
  { value: String(site.project.totalApartments), label: t.facts.apartments },
  { value: t.facts.typesValue, label: t.facts.types },
  { value: `${grossRange.min}–${grossRange.max} m²`, label: t.facts.area },
];
---

<section class="facts on-dark" aria-label={t.facts.title}>
  <dl class="container container--wide facts__list" data-reveal="stagger">
    {
      facts.map((f) => (
        <div class="facts__item">
          <dt class="facts__label">{f.label}</dt>
          <dd class="facts__value">{f.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .facts {
    padding-block: var(--space-xl);
  }

  .facts__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-l) var(--space-m);
  }

  @media (min-width: 52rem) {
    .facts__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .facts__item {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-3xs);
    padding-inline-start: var(--space-s);
    border-inline-start: 1px solid var(--color-accent);
  }

  .facts__value {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1;
    color: var(--color-accent-text);
  }

  .facts__label {
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }
</style>
