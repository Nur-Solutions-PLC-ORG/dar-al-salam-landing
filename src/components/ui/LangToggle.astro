---
/** EN | አማ toggle: real links with hreflang (DESIGN §5.0, §11). JS keeps the in-page hash when switching. */
import { getDict, homePath, htmlLang, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  class?: string;
}
const { lang, class: cls } = Astro.props;
const t = getDict(lang);
const items = [
  { l: 'en' as Lang, short: t.lang.en, name: 'English' },
  { l: 'am' as Lang, short: t.lang.am, name: 'አማርኛ' },
];
---

<div class:list={['lang-toggle', cls]} role="group" aria-label={t.a11y.language}>
  {
    items.map((it, i) => (
      <>
        {i > 0 && (
          <span class="lang-toggle__sep" aria-hidden="true">
            |
          </span>
        )}
        <a
          class="lang-toggle__link"
          href={homePath(it.l)}
          hreflang={htmlLang[it.l]}
          lang={htmlLang[it.l]}
          aria-current={it.l === lang ? 'page' : undefined}
          data-lang-link
        >
          <span aria-hidden="true" class:list={{ 'native-script': it.l === 'am' && lang !== 'am' }}>
            {it.short}
          </span>
          <span class="visually-hidden">{it.name}</span>
        </a>
      </>
    ))
  }
</div>

<style>
  .lang-toggle {
    display: inline-flex;
    align-items: center;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .lang-toggle__link {
    display: inline-grid;
    place-items: center;
    min-width: var(--tap-min);
    min-height: var(--tap-min);
    text-decoration: none;
    opacity: 0.74; /* ≥ 4.5:1 on ivory and on navy */
  }

  .lang-toggle__link[aria-current='page'] {
    opacity: 1;
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.45em;
  }

  @media (hover: hover) {
    .lang-toggle__link:hover {
      opacity: 1;
    }
  }

  .lang-toggle__sep {
    opacity: 0.4;
  }
</style>

<script>
  // Keep the in-page position (#explore/f7…) when switching language.
  document.addEventListener('click', (e) => {
    const a = (e.target as Element | null)?.closest<HTMLAnchorElement>('a[data-lang-link]');
    if (!a || a.getAttribute('aria-current') === 'page' || !location.hash) return;
    a.href = a.pathname + location.hash;
  });
</script>
