---
/**
 * Dome/arch frame (DESIGN §3.4). The mask is never animated: motion targets `.arch__clip`
 * (clip-path) and the media inside (transform).
 */
interface Props {
  class?: string;
  outline?: boolean;
  soft?: boolean;
  /** Optional CSS aspect-ratio for the frame, e.g. "4 / 5". */
  aspect?: string;
  [key: `data-${string}`]: string | undefined;
}
const { class: cls, outline = false, soft = false, aspect, ...rest } = Astro.props;
---

<div class:list={['arch', { 'arch--soft': soft }, cls]} style={aspect ? `aspect-ratio: ${aspect}` : undefined} {...rest}>
  {
    outline && (
      <div class="arch__outline" aria-hidden="true">
        <svg class="arch__cap" viewBox="0 -1 100 43" preserveAspectRatio="none">
          <path d="M0 42C0 22 22 12 38 7C45 5 49 2.5 50 0C51 2.5 55 5 62 7C78 12 100 22 100 42" />
        </svg>
        <span class="arch__side arch__side--l"></span>
        <span class="arch__side arch__side--r"></span>
      </div>
    )
  }
  <div class="arch__clip">
    <div class="arch__media">
      <slot />
    </div>
  </div>
</div>

<style>
  .arch__clip {
    height: 100%;
  }

  .arch__outline {
    position: absolute;
    inset: -10px -10px 0;
    container-type: inline-size;
    pointer-events: none;
    color: var(--accent);
  }

  .arch__cap {
    display: block;
    width: 100%;
    height: 42cqi;
    overflow: visible;
  }

  .arch__cap path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .arch--soft .arch__cap {
    height: 28cqi;
  }

  .arch__side {
    position: absolute;
    top: calc(42cqi - 1px);
    bottom: 0;
    width: 1px;
    background: currentColor;
  }

  .arch--soft .arch__side {
    top: calc(28cqi - 1px);
  }

  .arch__side--l {
    left: 0;
  }

  .arch__side--r {
    right: 0;
  }
</style>
