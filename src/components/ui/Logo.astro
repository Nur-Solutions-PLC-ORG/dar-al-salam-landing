---
/** Horizontal lockup: the mark + live-text wordmark (DESIGN §5.0). Colour follows currentColor; mark is gold. */
import Mark from './Mark.astro';
import { site } from '../../data/site';

interface Props {
  class?: string;
}
const { class: cls } = Astro.props;
---

<span class:list={['logo', cls]}>
  <Mark class="logo__mark" />
  <span class="logo__words" lang="en" aria-hidden="true">
    <span class="logo__name">Dar Al Salam</span>
    <span class="logo__sub">Real Estate</span>
  </span>
  <span class="visually-hidden">{site.company.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    line-height: 1;
  }

  .logo__mark {
    flex: none;
    height: 32px;
    width: auto;
    aspect-ratio: 415 / 319;
  }

  .logo__words {
    display: grid;
    gap: 0.28rem;
  }

  .logo__name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .logo__sub {
    font-family: 'Manrope', system-ui, sans-serif;
    font-size: 0.5625rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent-text);
    white-space: nowrap;
  }

  @media (max-width: 399px) {
    .logo__name {
      font-size: 1rem;
      letter-spacing: 0.06em;
    }
  }

  @media (min-width: 768px) {
    .logo__mark {
      height: 40px;
    }

    .logo__name {
      font-size: 1.3125rem;
    }

    .logo__sub {
      font-size: 0.625rem;
    }
  }
</style>
