---
/**
 * The gold mark via the external sprite public/mark-sprite.svg (generated by scripts/prepare-assets.mjs).
 * Decorative unless `label` is given. External <use> keeps the 15 KB path out of every page's HTML.
 */
import { markViewBox } from '../../data/mark.generated';

interface Props {
  class?: string;
  label?: string;
  /** Render body and dove as separately animatable groups. */
  split?: boolean;
}
const { class: cls, label, split = false } = Astro.props;
---

<svg
  class:list={['mark', cls]}
  viewBox={markViewBox}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    split ? (
      <>
        <g class="mark__body">
          <use href="/mark-sprite.svg#mark-body" />
        </g>
        <g class="mark__dove">
          <use href="/mark-sprite.svg#mark-dove" />
        </g>
      </>
    ) : (
      <>
        <use href="/mark-sprite.svg#mark-body" />
        <use href="/mark-sprite.svg#mark-dove" />
      </>
    )
  }
</svg>
