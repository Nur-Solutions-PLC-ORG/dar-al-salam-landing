---
/**
 * Pill button / link with the label-swap hover (DESIGN §6). Renders <a> when `href` is set.
 * The duplicate label is aria-hidden so the accessible name stays single.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  href?: string;
  variant?: 'primary' | 'secondary';
  icon?: 'arrow' | 'down' | 'whatsapp' | 'none';
  magnetic?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'class'> &
  Omit<HTMLAttributes<'button'>, 'class' | 'type'> & { type?: 'button' | 'submit' };

const { href, variant = 'primary', icon = 'none', magnetic = false, class: cls, type = 'button', ...rest } = Astro.props;
const label = await Astro.slots.render('default');
const Tag = href ? 'a' : 'button';
const tagProps = href ? { href } : { type };
---

<Tag
  class:list={['btn', { 'btn--secondary': variant === 'secondary' }, cls]}
  data-magnetic={magnetic ? '' : undefined}
  {...tagProps}
  {...rest}
>
  <span class="btn__inner">
    <span class="btn__text" set:html={label} />
    <span class="btn__text btn__text--dup" aria-hidden="true" set:html={label} />
  </span>
  {
    icon === 'arrow' && (
      <svg class="btn__icon" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M4 10h12M11 5l5 5-5 5" />
      </svg>
    )
  }
  {
    icon === 'down' && (
      <svg class="btn__icon" viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M10 4v12M5 11l5 5 5-5" />
      </svg>
    )
  }
  {
    icon === 'whatsapp' && (
      <svg class="btn__icon" viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
        <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z" />
      </svg>
    )
  }
</Tag>
