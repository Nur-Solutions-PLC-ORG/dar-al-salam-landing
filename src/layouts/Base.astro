---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { getDict, homePath, htmlLang, langs, ogLocale, otherLang, plain, type Lang } from '../i18n';
import MarkSprite from '../components/ui/MarkSprite.astro';
import ogDefault from '../assets/generated/hero-tower.jpg';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

export interface ImagePreload {
  srcset: string;
  sizes: string;
  type: string;
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** LCP image preload (hero AVIF srcset). */
  preloadImage?: ImagePreload;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Skip the global motion module (e.g. 404). */
  noMotion?: boolean;
}

const { lang, preloadImage, ogImage = ogDefault, noMotion = false } = Astro.props;
const t = getDict(lang);
const title = plain(Astro.props.title ?? t.meta.title);
const description = Astro.props.description ?? t.meta.description;
const ogImageAlt = Astro.props.ogImageAlt ?? t.meta.ogAlt;

// Absolute URLs only once the production origin is configured (site.url → astro.config `site`).
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = abs(homePath(lang));

const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', quality: 80 });
const ogUrl = abs(og.src);
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF7F2" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <!--
      Runs before first paint (DESIGN §7.1/7.2):
      - html.js: JS is available (menu button, enhanced controls).
      - html.intro: first visit this session and motion allowed → CSS-only curtain.
      - Safety: if motion.ts hasn't marked html.motion-ready within 2.5 s, drop html.js so nothing waits on it.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (!reduce && !sessionStorage.getItem('introSeen')) {
            d.classList.add('intro');
            sessionStorage.setItem('introSeen', '1');
          }
        } catch (e) {}
        setTimeout(function () {
          if (!d.classList.contains('motion-ready')) d.classList.remove('js');
        }, 2500);
      })();
    </script>

    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(homePath(l))} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={abs(homePath('en'))} />}

    <!-- Fonts: Cormorant + Manrope latin everywhere; the Ethiopic subset only on /am/. -->
    <link rel="preload" href="/fonts/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'am' && <link rel="preload" href="/fonts/noto-sans-ethiopic-subset.woff2" as="font" type="font/woff2" crossorigin />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <slot name="head" />
  </head>
  <body>
    <MarkSprite />
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
    {
      !noMotion && (
        <script>
          import { initMotion } from '../scripts/motion';
          initMotion();
        </script>
      )
    }
  </body>
</html>
