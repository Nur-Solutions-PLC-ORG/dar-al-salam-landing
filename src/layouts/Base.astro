---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { getDict, homePath, htmlLang, langs, ogLocale, otherLang, type Lang } from '../i18n';
import towerRender from '../assets/tower-render.jpg';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

export interface ImagePreload {
  srcset: string;
  sizes: string;
  type: string;
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** LCP image preload (e.g. hero AVIF srcset). */
  preloadImage?: ImagePreload;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
}

const { lang, preloadImage, ogImage = towerRender } = Astro.props;
const t = getDict(lang);
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const ogImageAlt = Astro.props.ogImageAlt ?? t.meta.ogAlt;

// Absolute URLs only when the production origin is configured (site.url → astro.config `site`).
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = abs(homePath(lang));

const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', position: 'center', format: 'jpg', quality: 80 });
const ogUrl = abs(og.src);

const themeColor = '#1A273F';
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="generator" content={Astro.generator} />

    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.site &&
        langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(homePath(l))} />)
    }
    {Astro.site && <link rel="alternate" hreflang="x-default" href={abs(homePath('en'))} />}

    <!-- Fonts: preload only what the first viewport needs. -->
    <link rel="preload" href="/fonts/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cormorant-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Noto Sans Ethiopic (~200 KB) is deliberately NOT preloaded on /am/: it competed with the hero image
         (Lighthouse mobile LCP 3.6 s vs 2.5 s on EN). font-display: swap shows a system Ethiopic font first. -->

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <!-- Icons -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
