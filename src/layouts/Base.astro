---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';
import { getDict, homePath, htmlLang, langs, ogLocale, otherLang, plain, type Lang } from '../i18n';
import ogDefault from '../assets/generated/hero-tower.jpg';

import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

export interface ImagePreload {
  srcset: string;
  sizes: string;
  type: string;
}

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** LCP image preload (hero AVIF srcset). */
  preloadImage?: ImagePreload;
  ogImage?: ImageMetadata;
  ogImageAlt?: string;
  /** Skip the global motion module (e.g. 404). */
  noMotion?: boolean;
}

const { lang, preloadImage, ogImage = ogDefault, noMotion = false } = Astro.props;
const t = getDict(lang);
const title = plain(Astro.props.title ?? t.meta.title);
const description = Astro.props.description ?? t.meta.description;
const ogImageAlt = Astro.props.ogImageAlt ?? t.meta.ogAlt;

// Absolute URLs only once the production origin is configured (site.url → astro.config `site`).
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : undefined);
const canonical = abs(homePath(lang));

const og = await getImage({ src: ogImage, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', quality: 80 });
const ogUrl = abs(og.src);
---

<!doctype html>
<html lang={htmlLang[lang]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FBF7F2" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />

    <!--
      Runs before first paint (DESIGN §7.1/7.2):
      - html.js: JS is available (menu button, mobile CTA, enhanced controls). Never removed later
        (review M1: nothing is hidden by CSS waiting for motion.ts, so no safety timeout is needed).
      - html.intro: first visit this session and motion allowed → CSS-only curtain.
    -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        try {
          if (!reduce && !sessionStorage.getItem('introSeen')) {
            d.classList.add('intro');
            sessionStorage.setItem('introSeen', '1');
          }
        } catch (e) {}
      })();
    </script>

    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && langs.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={abs(homePath(l))} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={abs(homePath('en'))} />}

    <!-- Fonts: Manrope everywhere; Cormorant only on EN (the /am H1 is Noto); the Ethiopic subset only on /am/. -->
    <link rel="preload" href="/fonts/manrope-latin-wght.woff2" as="font" type="font/woff2" crossorigin />
    {lang === 'en' && <link rel="preload" href="/fonts/cormorant-garamond-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />}
    {lang === 'am' && <link rel="preload" href="/fonts/noto-sans-ethiopic-subset.woff2" as="font" type="font/woff2" crossorigin />}

    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          imagesrcset={preloadImage.srcset}
          imagesizes={preloadImage.sizes}
          type={preloadImage.type}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    {ogUrl && <meta property="og:image:width" content="1200" />}
    {ogUrl && <meta property="og:image:height" content="630" />}
    {ogUrl && <meta property="og:image:alt" content={ogImageAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogUrl && <meta name="twitter:image" content={ogUrl} />}

    <slot name="head" />
  </head>
  <body data-cursor-labels={JSON.stringify(t.cursor)}>
    <a class="skip-link" href="#main">{t.a11y.skipToContent}</a>
    <slot />
    {
      !noMotion && (
        <script>
          // Anchor handling + scroll helpers are tiny and needed immediately; GSAP/Lenis (motion.ts) are not:
          // the hero is pure CSS, so motion.ts loads after `load` + idle to keep it out of the LCP window.
          import '../scripts/motion-api';
          // rev 5: a film opener clicked before film.ts has wired its own listeners (they preventDefault first)
          document.addEventListener('click', (e) => {
            if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            const a = (e.target as Element | null)?.closest<HTMLElement>('[data-film-open]');
            if (!a) return;
            e.preventDefault();
            void import('../scripts/film').then((m) => m.openFilm(a));
          });
          const start = () => {
            void import('../scripts/motion').then((m) => m.initMotion());
            void import('../scripts/film').then((m) => m.initFilm()); // rev 5: hero film card (§5.11)
          };
          const go = () =>
            'requestIdleCallback' in window ? window.requestIdleCallback(() => void start(), { timeout: 2000 }) : setTimeout(start, 200);
          if (document.readyState === 'complete') go();
          else window.addEventListener('load', go, { once: true });
        </script>
      )
    }
  </body>
</html>
